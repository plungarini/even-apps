# Even Hub app submodules
# Each app is an independent git repo under apps/
#
# To add a new app:
#   git submodule add git@github.com:plungarini/<app-name>-even.git apps/<app-name>
#
# Format:
# [submodule "<app-name>"]
#     path = apps/<app-name>
#     url = git@github.com:plungarini/<app-name>-even.git
[submodule "apps/reddit-feed"]
	path = apps/reddit-feed
	url = git@github.com:plungarini/reddit-feed-even.git
[submodule "apps/smokeless"]
	path = apps/smokeless
	url = git@github.com:plungarini/smokeless-even.git
[submodule "apps/the-void"]
	path = apps/the-void
	url = git@github.com:plungarini/the-void-even.git
[submodule "apps/phase"]
	path = apps/phase
	url = git@github.com:plungarini/phase-even.git
